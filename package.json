{
  "name": "whatsapp-eletron",
  "version": "2.3.0",
  "description": "WhatsApp Eletron — aplicativo desktop para WhatsApp Web com janela personalizável e ajustes visuais",
  "author": "WillSPACCE",
  "homepage": "https://github.com/WillyanMartinss/Whatsapp-Eletron",
  "repository": {
    "type": "git",
    "url": "https://github.com/WillyanMartinss/Whatsapp-Eletron.git"
  },
  "bugs": {
    "url": "https://github.com/WillyanMartinss/Whatsapp-Eletron/issues"
  },
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "dist": "npm run build",
    "build": "npm run build:portable && npm run build:installer",
    "build:portable": "npm run clean && electron-builder --win portable --x64",
    "build:installer": "npm run clean && electron-builder --win nsis --x64",
    "postbuild": "node scripts/postbuild.js",
    "release": "electron-builder --win --x64 --publish always"
  },
  "build": {
    "appId": "com.whatsapp.eletron",
    "productName": "whatsapp-eletron",
    "directories": {
      "output": "dist"
    },
    "icon": "build/icon.ico",
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "signExecutable": false,
      "artifactName": "whatsapp-eletron-${version}.${ext}"
    },
    "portable": {
      "artifactName": "whatsapp-eletron-portable-${version}.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "whatsapp-eletron-installer-${version}.exe",
      "deleteAppDataOnUninstall": true,
      "shortcutName": "WhatsApp Eletron"
    }
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest",
    "rcedit": "^5.0.2"
  }
}
